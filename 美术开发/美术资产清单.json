  "direction": {
    "keywords": [
      "火塘余光",
      "记忆消逝",
      "低墨版画",
      "矿物色",
      "辽阔留白"
    ],
    "rendering": "细线蚀刻与块面剪影结合，局部使用矿物色和火光；避免写实影视概念图质感。",
    "deity_approach": "以环境、象征物和姿态建立神性，不依赖统一的正面人物肖像。",
    "culture_rule": "每尊神使用其来源文化可核验的自然环境与叙事母题；不拼贴其他文化符号，不直接复刻神圣纹样。",
    "print": "浅暖纸底、深色线稿、每张卡最多三种主色；重要信息不用纯色面积承载。"
  },
